MOSAIC_OLLAMA_URL=http://127.0.0.1:11434
MOSAIC_PRIMARY_MODEL=gpt-oss:20b
MOSAIC_REQUEST_TIMEOUT=120
MOSAIC_LOG_LEVEL=INFO
MOSAIC_ALLOWED_MODELS=gpt-oss:20b,qwen3:8b
MOSAIC_CONTEXT_LIMIT=20
MOSAIC_KEEP_ALIVE=5m
MOSAIC_DB_PATH=
MOSAIC_SYSTEM_PROMPT=
# Generate a 32+ character token locally; do not commit the actual value.
MOSAIC_API_TOKEN=
MOSAIC_ALLOWED_ROOTS=
MOSAIC_ALLOWED_APPLICATIONS="Visual Studio Code,Finder,Calculator,Notes,Safari,Google Chrome"
MOSAIC_AUDIT_CAPACITY=500
MOSAIC_MAX_TOOL_CALLS=3
MOSAIC_MAX_TOOL_SECONDS=30
MOSAIC_MAX_TOOL_ITERATIONS=3
MOSAIC_MAX_ORCHESTRATION_SECONDS=180

# Phase 6: existing local files only. No models/voices download automatically.
MOSAIC_WHISPER_EXECUTABLE=/opt/homebrew/bin/whisper-cli
MOSAIC_WHISPER_MODEL="${HOME}/AI-Models/Whisper/ggml-base.bin"
MOSAIC_VOICE_LANGUAGE=auto
MOSAIC_MICROPHONE=
MOSAIC_VAD_THRESHOLD=0.015
MOSAIC_VAD_SILENCE_SECONDS=0.8
MOSAIC_TTS_VOICE=
MOSAIC_TTS_SPEED=1

# Isolated cached neural voice runtime; no dependencies/weights auto-install.
MOSAIC_TTS_PROVIDER=kokoro
MOSAIC_NEURAL_PYTHON=/opt/anaconda3/envs/mosaic-voice/bin/python
# Empty selects cached main revision; an explicit local snapshot pins it.
MOSAIC_KOKORO_MODEL=
MOSAIC_NEURAL_WARMUP=1
MOSAIC_NEURAL_TIMEOUT=60
MOSAIC_NEURAL_IDLE_SECONDS=180
MOSAIC_NEURAL_QUEUE_SIZE=3
MOSAIC_NEURAL_MIN_AVAILABLE_MB=1024
# Disabled by default; if enabled, fallback is labeled in headers/CLI/status.
MOSAIC_TTS_FALLBACK=0
# Explicit modes only: default, low, medium, high. No automatic model switch.
MOSAIC_VOICE_REASONING=default
# Tools on preserves completed-response speech. Set 0 for tool-free streaming.
MOSAIC_VOICE_TOOLS=1
